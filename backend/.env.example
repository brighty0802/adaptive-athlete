# Backend only. Copy to .env and fill in your real PostgreSQL connection URI.
# For Supabase, copy the Session pooler URI from Connect (IPv4, port 5432).
# URL-encode special characters in the password. Never put this in frontend/.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/postgres?sslmode=require

# Optional: replaces the development frontend origin allowlist.
# CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://192.168.1.106:3000

# Railway only: enter these in service Variables, alongside DATABASE_URL above.
# APP_ENV=production
# CORS_ORIGINS=https://YOUR-VERCEL-PRODUCTION-DOMAIN
# Railway supplies PORT automatically; do not copy database secrets to Vercel.

# Optional: a separate disposable PostgreSQL database for integration tests.
# Never use your real training database here.
# TEST_DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/adaptive_athlete_test
