# Optional: defaults to the browser's hostname on port 8000 for local development.
# Use a laptop LAN address here (not localhost) if testing this override on a phone.
# NEXT_PUBLIC_API_BASE_URL=http://192.168.1.106:8000

# Vercel Production environment (required at build time; redeploy after changes):
# NEXT_PUBLIC_API_BASE_URL=https://YOUR-RENDER-SERVICE.onrender.com
# Only a public API address belongs here. Never add DATABASE_URL or Supabase keys.
